# Copy to .env for local development. Every variable here is required unless marked optional.

# AWS region the self-hosted runner infrastructure is deployed into. Read by the integration suite,
# which fails naming this variable rather than skipping without it.
#
# The Pulumi stack reads its own region from `aws:region` in Pulumi.<stack>.yaml, not from here —
# the two are set separately, and the stack's value is the one that decides where resources land.
AWS_REGION=us-east-1

# Passphrase Pulumi uses to encrypt secrets in stack configuration. Required by the local file
# backend (`pulumi login --local`) — there is no key management service holding this for you.
PULUMI_CONFIG_PASSPHRASE=

# Optional. Set to point Pulumi at a different backend; unset uses whatever `pulumi login`
# recorded. Example for state kept beside the repo: file://.
# PULUMI_BACKEND_URL=

# ---------------------------------------------------------------------------------------------
# Stack configuration
#
# The stack itself is configured through Pulumi config rather than the environment, so that the
# values are versioned in Pulumi.<stack>.yaml and visible in a `pulumi preview` diff. They are
# listed here because .env.example is this repository's configuration contract; set them with
# `pulumi config set nightshift:<key> <value>`.
#
# Required — no default, and `pulumi preview` fails naming the key if absent:
#
#   nightshift:repository   Repository the runner registers against, as `owner/repo`.
#   nightshift:vpcId        An existing VPC. This stack never creates one.
#   nightshift:subnetIds    Subnets to launch into. MUST have a NAT route: the runner gets no
#                           public IP and must reach github.com outbound. In a subnet without
#                           egress the instance boots, looks healthy, and never registers.
#
# Optional — the default applies when absent:
#
#   nightshift:namePrefix              night-shift   Prefix for every resource name.
#   nightshift:environment             dev           Environment name, used in names and tags.
#   nightshift:instanceType            t3.medium     Runner instance type.
#   nightshift:rootVolumeSizeGib       64            Root volume size, 8–1024.
#   nightshift:runnerGroup             Default       GitHub runner group to join.
#   nightshift:runnerLabels            self-hosted,linux,x64,night-shift
#   nightshift:artifactExpiryDays      30            Artifact lifetime in S3, 1–365.
#   nightshift:createOidcProvider      true          Set false when the account already has a
#                                                    GitHub OIDC provider — only one may exist per
#                                                    issuer URL, and a second create fails with
#                                                    EntityAlreadyExists.
#   nightshift:existingOidcProviderArn (none)        Required when createOidcProvider is false;
#                                                    absent then, `pulumi preview` fails.
#   nightshift:extraTags               {}            Extra tags merged onto every resource.
#
# The GitHub runner registration token is NOT configured here. The stack creates an SSM
# SecureString parameter for it and a human places the value after the first deploy — see the
# bootstrap section of README.md. Tokens expire one hour after they are generated.
